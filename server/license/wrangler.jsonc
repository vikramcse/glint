{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glint-license",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glint-licenses",
      // Replace with the id printed by `wrangler d1 create glint-licenses`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "MAIL_FROM": "Glint <licenses@glint.app>",
    "STRICT_KEYS": "false"
  }
  // Secrets (wrangler secret put …): LICENSE_PRIVATE_KEY, LEMONSQUEEZY_WEBHOOK_SECRET, RESEND_API_KEY
}
